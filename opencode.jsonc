{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": [],
  "provider": {
    "deepseek_v3": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek V3"
        }
      }
    },
    "deepseek_official": {
      "name": "DeepSeek Official",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    },
    "cerebras_cloud": {
      "name": "Cerebras Free Cloud",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.cerebras.ai/v1"
      },
      "models": {
        "Llama 3.3 70B": {
          "name": "llama3.3-70b"
        },
        "Llama 3.1 8B": {
          "name": "llama-3.1-8b"
        }
      }
    },
    "deepseek-api": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-chat": {
          "name": "DeepSeek Chat"
        },
        "deepseek-reasoner": {
          "name": "DeepSeek Reasoner"
        }
      }
    },
    "free-llm-gateway": {
      "name": "Free LLM Gateway (Local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "opencode-local-key-2026"
      },
      "models": {
        "nvidia/nemotron-3-ultra": {
          "name": "Nemotron 3 Ultra (NVIDIA)"
        },
        "nvidia/nemotron-3.5-lightning": {
          "name": "Nemotron 3.5 Lightning (NVIDIA)"
        },
        "nvidia/llama-3.3-70b": {
          "name": "Llama 3.3 70B (NVIDIA)"
        },
        "gpt-4": {
          "name": "Best Available (Auto-routed)"
        },
        "gpt-4o": {
          "name": "GPT-4o via Gateway"
        },
        "claude-3.5-sonnet": {
          "name": "Claude via Gateway"
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        },
        "llama-3.3-70b": {
          "name": "Llama 3.3 70B"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "kimi-k2": {
          "name": "Kimi K2"
        },
        "glm-4.5": {
          "name": "GLM-4.5"
        }
      }
    }
  }
}
