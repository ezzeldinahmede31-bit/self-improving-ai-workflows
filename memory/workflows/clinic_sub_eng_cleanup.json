    {
      "parameters": {
        "jsCode": "// Decide no-show (never confirmed) and archive last visit; pass item through.\nconst inp = $input.first().json;\nconst rec = inp.record || {};\nconst rAt = Number(rec.remindedAt) || null;\nconst confAt = Number(rec.confirmedAt) || null;\nconst fresh = confAt !== null && rAt !== null && confAt > rAt;\nreturn [{ json: { record: rec, needsCleanup: inp.needsCleanup, needsEscalation: inp.needsEscalation,\n  needsInfo: inp.needsInfo, needsRemind: inp.needsRemind, needsPostVisit: inp.needsPostVisit,\n  isNoShow: !fresh, chatId: rec.chatId || '', apptISO: rec.appointmentISO || '' } }];"
      },
      "id": "eng-237",
      "name": "Tally No-Show + Archive",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        1080
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c-x",
              "leftValue": "={{ $input.item.json.isNoShow === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "eng-342",
      "name": "Was No-Show?",
