    {
      "parameters": {
        "jsCode": "// Normalize booking input into a slot key plus ISO window (per-service duration, KB mirror).\nconst MINUTES = Object.assign({}, {'General exam': 30, 'Cleaning and polishing': 45, 'Filling per tooth': 45, 'Root canal': 90, 'Braces consult': 30, 'Implant consult': 30, 'Whitening': 60}, (function(){ try { return $('Build Durations Map').first().json.minutesMap || {}; } catch (e) { return {}; } })());\nconst inp = $input.first().json;\nconst doctor = inp.doctorName ? String(inp.doctorName).trim() : 'any-doctor';\nconst date = inp.date ? String(inp.date).trim() : '';\nconst time = inp.time ? String(inp.time).trim() : '';\nconst service = inp.serviceName ? String(inp.serviceName).trim() : 'general visit';\nconst who = inp.patientName ? String(inp.patientName).trim() : 'patient';\nconst chat = inp.patientChatId ? String(inp.patientChatId) : (inp.patientPhone ? String(inp.patientPhone) : '');\nconst mins = MINUTES[service] || 30;\nconst cairoISO = (d, t) => {\n  const try2 = d + 'T' + t + ':00+02:00';\n  const wall = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Cairo', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(try2));\n  const hm = wall.split(':');\n  const wt = t.split(':');\n  return (Number(hm[0]) === Number(wt[0]) && Number(hm[1]) === Number(wt[1])) ? try2 : (d + 'T' + t + ':00+03:00');\n};\nconst start = new Date(cairoISO(date, time));\nconst end = new Date(start.getTime() + mins * 60 * 1000);\nconst isPast = isNaN(start.getTime()) || start.getTime() < Date.now() + 15 * 60 * 1000;\nreturn [{ json: { slotKey: 'slot:' + doctor + ':' + date + ':' + time, startISO: isNaN(start.getTime()) ? '' : start.toISOString(), endISO: isNaN(start.getTime()) ? '' : end.toISOString(), doctor: doctor, date: date, time: time, service: service, minutes: mins, patientName: who, patientChat: chat, isPast: isPast } }];"
      },
