        "jsCode": "// Build the reminder record (immutable facts for the reminder engine).\nconst prev = $('Decide Slot Free').first().json;\nconst rep = $input.first().json;\nconst today = new Date().toISOString().slice(0, 10);\nreturn [{ json: { chatId: prev.patientChat, appointmentISO: prev.startISO, bookedDate: today, leadHours: 24, doctor: prev.doctor, service: prev.service, patientName: prev.patientName, slotKey: prev.slotKey, date: prev.date, time: prev.time, eventId: rep.eventId ? rep.eventId : '', queueNumber: rep.queueNumber ? rep.queueNumber : 0 } }];"
