      "parameters": {
        "jsCode": "// Decide window state from the events API envelope (always exactly one item).\nconst inp = $input.first().json;\nconst prev = $('Build Slot Window').first().json;\nconst failed = inp.error !== undefined;\nconst items = failed ? [] : (Array.isArray(inp.items) ? inp.items : []);\nconst free = !failed && items.length === 0;\nconst base = { free: free, checkFailed: failed, slotKey: prev.slotKey, startISO: prev.startISO, endISO: prev.endISO, doctor: prev.doctor, date: prev.date, time: prev.time, service: prev.service, patientName: prev.patientName, patientChat: prev.patientChat };\nreturn [{ json: base }];",
        "mode": "runOnceForAllItems"
