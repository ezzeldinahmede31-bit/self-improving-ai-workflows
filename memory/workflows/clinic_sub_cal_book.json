      "parameters": {
        "jsCode": "// +-12h window around the requested slot for alternative hunting.\nlet prev = null;\ntry { prev = $('Decide Slot Free').first().json; } catch (e) { prev = null; }\nif (!prev) { prev = $('Build Slot Window').first().json; }\nconst s = new Date(prev.startISO).getTime();\nconst e = new Date(prev.endISO).getTime();\nreturn [{ json: { winMin: new Date(s - 12 * 3600 * 1000).toISOString(),\n  winMax: new Date(e + 12 * 3600 * 1000).toISOString() } }];"
      },
