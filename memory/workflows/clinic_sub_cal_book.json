        "jsCode": "// Booking-confirmed contract for the agent (number from queue claim, event from create).\nconst prev = $('Decide Slot Free').first().json;\nconst q = $('Claim Queue Number').item.json;\nconst eid = $('Create Calendar Event').first().json.id;\nconst num = q[Object.keys(q)[0]];\nreturn [{ json: { booked: true, eventId: eid ? String(eid) : '', queueNumber: num, message: 'تم الحجز: ' + prev.service + ' مع ' + prev.doctor + ' يوم ' + prev.date + ' الساعة ' + prev.time + ' باسم ' + prev.patientName + '. رقم دورك ' + String(num) + '. العنوان: القاهرة — العنوان التجريبي (DEMO).', slotKey: prev.slotKey } }];"
