    {
      "parameters": {
        "jsCode": "// Verified alternatives: requested Cairo hour +-1/+-2, inside 09:00-22:00, no overlap.\nconst inp = $input.first().json;\nlet prev = null;\ntry { prev = $('Decide Slot Free').first().json; } catch (e) { prev = null; }\nif (!prev) { prev = $('Build Slot Window').first().json; }\nconst items = (inp.error !== undefined || !Array.isArray(inp.items)) ? [] : inp.items;\nconst busy = items.map((ev) => {\n  const s = ev.start ? Date.parse(ev.start.dateTime || ev.start.date) : NaN;\n  const t = ev.end ? Date.parse(ev.end.dateTime || ev.end.date) : NaN;\n  return [s, t];\n}).filter((x) => !isNaN(x[0]) && !isNaN(x[1]));\nconst reqStart = new Date(prev.startISO).getTime();\nconst mins = prev.minutes || 30;\nconst cairoH = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Cairo', hour: '2-digit', hour12: false }).format(new Date(reqStart)));\nconst dayStr = prev.date;\nconst out = [];\nfor (const dh of [-1, 1, -2, 2]) {\n  if (out.length >= 2) { break; }\n  const h = cairoH + dh;\n  if (h < 9 || h > 21) { continue; }\n  const hh = String(h).padStart(2, '0');\n  const mm = String(prev.time ? prev.time.slice(3, 5) : '00');\n  const guess2 = dayStr + 'T' + hh + ':' + mm + ':00+02:00';\n  const wall = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Cairo', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(guess2));\n  const iso = (wall.slice(0, 5) === (hh + ':' + mm)) ? guess2 : (dayStr + 'T' + hh + ':' + mm + ':00+03:00');\n  const s = new Date(iso).getTime();\n  const e = s + mins * 60 * 1000;\n  const clash = busy.some((b) => s < b[1] && b[0] < e);\n  if (!clash && Math.abs(s - reqStart) > 60000) { out.push({ date: dayStr, time: hh + ':' + mm }); }\n}\nreturn [{ json: { alternatives: out } }];"
      },
