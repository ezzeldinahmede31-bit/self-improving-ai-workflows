    {
      "parameters": {
        "jsCode": "// Extract patient payload covering Meta plus Evolution providers (table dispatch,\n// ternaries only - no branch chains).\nconst inp = $input.first().json;\nconst provider = inp.provider;\nconst body = inp.body;\nlet messageId = 'msg_' + Date.now();\nlet patientPhone = 'unknown';\nlet pushName = 'esteemed patient';\nlet textMessage = '';\nlet isAudio = false;\nlet audioId = null;\nlet audioUrl = null;\nlet phoneNumberId = null;\nconst META_TEXT = {\n  text: (m) => m.text ? (m.text.body ? m.text.body : '') : '',\n  interactive: (m) => {\n    const im = m.interactive ? m.interactive : null;\n    const btn = im ? (im.button_reply ? im.button_reply : null) : null;\n    const lst = im ? (im.list_reply ? im.list_reply : null) : null;\n    return btn ? (btn.title ? btn.title : (btn.id ? btn.id : '')) : (lst ? (lst.title ? lst.title : '') : '');\n  },\n  image: (m) => m.image ? (m.image.caption ? '[patient sent image: ' + m.image.caption + ']' : '[patient sent image]') : '[patient sent image]',\n  document: (m) => m.document ? (m.document.filename ? '[patient sent document: ' + m.document.filename + ']' : '[patient sent document]') : '[patient sent document]',\n  video: (m) => m.video ? (m.video.caption ? '[patient sent video: ' + m.video.caption + ']' : '[patient sent video]') : '[patient sent video]',\n  location: (m) => m.location ? ('[patient geo location: Lat ' + m.location.latitude + ', Lng ' + m.location.longitude + ']') : '[patient geo location]',\n  audio: (m) => '',\n  unknown: (m) => '[unsupported message type]'\n};\nif (provider === 'meta') {\n  const val = body.entry[0].changes[0].value;\n  const m = val.messages[0];\n  const c = val.contacts ? val.contacts[0] : null;\n  messageId = m.id ? m.id : messageId;\n  patientPhone = m.from ? m.from : '';\n  pushName = c ? (c.profile ? (c.profile.name ? c.profile.name : pushName) : pushName) : pushName;\n  phoneNumberId = val.metadata ? (val.metadata.phone_number_id ? val.metadata.phone_number_id : null) : null;\n  const kind = m.type ? m.type : 'unknown';\n  const fn = META_TEXT[kind] ? META_TEXT[kind] : META_TEXT.unknown;\n  textMessage = fn(m);\n  isAudio = kind === 'audio';\n  audioId = kind === 'audio' ? (m.audio ? (m.audio.id ? m.audio.id : null) : null) : null;\n} else {\n  const data = body.data ? body.data : body;\n  const key = data.key ? data.key : {};\n  const mo = data.message ? data.message : {};\n  messageId = key.id ? key.id : messageId;\n  const jid = key.remoteJid ? key.remoteJid : '';\n  patientPhone = jid.replace(/[^0-9]/g, '');\n  pushName = data.pushName ? data.pushName : pushName;\n  const conv = mo.conversation ? mo.conversation : (mo.extendedTextMessage ? (mo.extendedTextMessage.text ? mo.extendedTextMessage.text : '') : '');\n  const btn = mo.buttonsResponseMessage ? (mo.buttonsResponseMessage.selectedDisplayText ? mo.buttonsResponseMessage.selectedDisplayText : (mo.buttonsResponseMessage.selectedButtonId ? mo.buttonsResponseMessage.selectedButtonId : '')) : '';\n  const img = mo.imageMessage ? (mo.imageMessage.caption ? '[patient sent image: ' + mo.imageMessage.caption + ']' : '[patient sent image]') : '';\n  const doc = mo.documentMessage ? (mo.documentMessage.fileName ? '[patient sent document: ' + mo.documentMessage.fileName + ']' : '[patient sent document]') : '';\n  const vid = mo.videoMessage ? '[patient sent video]' : '';\n  textMessage = conv ? conv : (btn ? btn : (img ? img : (doc ? doc : vid)));\n  isAudio = mo.audioMessage ? true : (mo.voiceMessage ? true : false);\n  audioUrl = mo.audioMessage ? (mo.audioMessage.url ? mo.audioMessage.url : null) : null;\n}\npatientPhone = String(patientPhone).replace(/[^0-9]/g, '');\nreturn [{ json: { messageId: messageId, patientPhone: patientPhone, pushName: pushName, provider: provider, isAudio: isAudio, audioId: audioId, audioUrl: audioUrl, textMessage: String(textMessage).trim(), phoneNumberId: phoneNumberId, timestamp: new Date().toISOString() } }];"
