      "parameters": {
        "jsCode": "// Whisper quality check: fall back to a polite retry prompt on empty audio.\nconst item = $input.first().json;\nconst prev = $('Extract Patient Payload').first().json;\nconst t = item.text ? String(item.text).trim() : '';\nconst bad = item.error ? true : (t.length < 2);\nconst fallback = '[voice note unclear - kindly ask the patient to re-record in a quiet place or type the message]';\nreturn [{ json: { patientPhone: prev.patientPhone, pushName: prev.pushName, provider: prev.provider, phoneNumberId: prev.phoneNumberId, finalMessage: bad ? fallback : t, wasVoice: true, isAudioMuffled: bad } }];"
      },
      "id": "clinic-node-4d-whisper-check",
