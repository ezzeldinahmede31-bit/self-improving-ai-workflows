        "jsCode": "// Verify Evolution API key header (fail-closed, constant-time compare).\nconst inp = $input.first().json;\nconst body = inp.body;\nconst headers = inp.headers ? inp.headers : {};\nconst apiKey = $env.EVOLUTION_API_KEY ? $env.EVOLUTION_API_KEY : '';\nif (!apiKey) { throw new Error('EVOLUTION_API_KEY is not configured - refusing all traffic'); }\nconst rawKey = headers.apikey ? headers.apikey : (headers.authorization ? headers.authorization : '');\nconst received = String(rawKey).replace(/^Bearer\\s+/i, '').trim();\nfunction safeEqual(a, b) {\n  const x = String(a);\n  const y = String(b);\n  if (x.length !== y.length) { return false; }\n  let d = 0;\n  for (let i = 0; i < x.length; i++) { d |= x.charCodeAt(i) ^ y.charCodeAt(i); }\n  return d === 0;\n}\nif (!safeEqual(received, apiKey)) { throw new Error('Unauthorized Evolution API Webhook: Invalid API key header - rejected'); }\nreturn [{ json: { provider: 'evolution', verified: true, body: body, headers: headers } }];"
