        "jsCode": "// Verify Meta HMAC signature (fail-closed). The webhook headerAuth credential\n// is the primary gate; this node adds provider-level sender verification.\n// Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto on self-hosted n8n so require works.\nconst inp = $input.first().json;\nconst body = inp.body;\nconst headers = inp.headers ? inp.headers : {};\nconst secret = $env.META_APP_SECRET ? $env.META_APP_SECRET : '';\nif (!secret) { throw new Error('META_APP_SECRET is not configured - refusing all traffic'); }\nconst sig = headers['x-hub-signature-256'] ? String(headers['x-hub-signature-256']).trim() : '';\nif (!sig) { throw new Error('Missing signature header - rejected'); }\nif (!$binary) { throw new Error('Raw body not captured - cannot verify signature, rejected (safety)'); }\nlet cryptoLib = null;\ntry { cryptoLib = require('crypto'); } catch (err) { cryptoLib = null; }\nif (!cryptoLib) { throw new Error('Crypto unavailable (set NODE_FUNCTION_ALLOW_BUILTIN=crypto) - rejected (safety)'); }\nconst expected = 'sha256=' + cryptoLib.createHmac('sha256', secret).update(Buffer.from($binary.data.data, 'base64')).digest('hex');\nfunction safeEqual(a, b) {\n  const x = String(a);\n  const y = String(b);\n  if (x.length !== y.length) { return false; }\n  let d = 0;\n  for (let i = 0; i < x.length; i++) { d |= x.charCodeAt(i) ^ y.charCodeAt(i); }\n  return d === 0;\n}\nif (!safeEqual(sig, expected)) { throw new Error('Invalid HMAC signature - rejected'); }\nreturn [{ json: { provider: 'meta', verified: true, body: body, headers: headers } }];"
      },
