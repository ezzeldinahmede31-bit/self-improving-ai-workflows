        "width": 420,
        "color": 4
      },
      "id": "sticky-find-1",
      "name": "Lane Docs",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -300,
        -200
      ]
    }
  ],
