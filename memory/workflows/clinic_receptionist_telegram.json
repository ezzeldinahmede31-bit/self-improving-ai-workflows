    {
      "parameters": {
        "jsCode": "// Verify Telegram secret_token header (fail-closed). The webhook\n// headerAuth credential is the primary gate; this node adds a second check\n// against the container env value before any payload handling.\nconst inp = $input.first().json;\nconst body = inp.body;\nconst headers = inp.headers ? inp.headers : {};\nconst secret = $env.TELEGRAM_WEBHOOK_SECRET ? $env.TELEGRAM_WEBHOOK_SECRET : '';\nif (!secret) { throw new Error('TELEGRAM_WEBHOOK_SECRET is not configured - refusing all traffic'); }\nconst got = headers['x-telegram-bot-api-secret-token'] ? String(headers['x-telegram-bot-api-secret-token']).trim() : '';\nif (!got) { throw new Error('Missing Telegram secret header - rejected'); }\nfunction safeEqual(a, b) {\n  const x = String(a);\n  const y = String(b);\n  if (x.length !== y.length) { return false; }\n  let d = 0;\n  for (let i = 0; i < x.length; i++) { d |= x.charCodeAt(i) ^ y.charCodeAt(i); }\n  return d === 0;\n}\nif (!safeEqual(got, secret)) { throw new Error('Invalid Telegram secret header - rejected'); }\nreturn [{ json: { provider: 'telegram', verified: true, body: body, headers: headers } }];"
      },
      "id": "tg-2-verify",
      "name": "Verify Telegram Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract patient payload from a Telegram Update (table dispatch,\n// ternaries only). Supports text, voice, button taps, photo, document,\n// video and location updates.\nconst inp = $input.first().json;\nconst body = inp.body;\nconst upd = body.edited_message ? body.edited_message : (body.message ? body.message : null);\nconst cb = body.callback_query ? body.callback_query : null;\nlet messageId = 'tg_' + Date.now();\nlet chatId = 'unknown';\nlet userId = 'unknown';\nlet pushName = 'esteemed patient';\nlet textMessage = '';\nlet isAudio = false;\nlet voiceFileId = null;\nif (cb) {\n  messageId = cb.id ? cb.id : messageId;\n  const from = cb.from ? cb.from : {};\n  userId = from.id ? String(from.id) : userId;\n  pushName = from.first_name ? from.first_name : pushName;\n  chatId = cb.message ? (cb.message.chat ? String(cb.message.chat.id) : chatId) : chatId;\n  textMessage = cb.data ? String(cb.data) : '';\n} else if (upd) {\n  messageId = upd.message_id ? ('tg_' + String(upd.message_id)) : messageId;\n  const from = upd.from ? upd.from : {};\n  userId = from.id ? String(from.id) : userId;\n  pushName = from.first_name ? from.first_name : pushName;\n  chatId = upd.chat ? String(upd.chat.id) : chatId;\n  const KIND = {\n    text: (m) => m.text ? String(m.text) : '',\n    voice: (m) => '',\n    photo: (m) => m.caption ? ('[patient sent image: ' + m.caption + ']') : '[patient sent image]',\n    document: (m) => '[patient sent document]',\n    video: (m) => m.caption ? ('[patient sent video: ' + m.caption + ']') : '[patient sent video]',\n    location: (m) => m.location ? ('[patient geo location: Lat ' + m.location.latitude + ', Lng ' + m.location.longitude + ']') : '[patient geo location]',\n    sticker: (m) => '[patient sent sticker]',\n    unknown: (m) => '[unsupported message type]'\n  };\n  const kind = upd.text ? 'text' : (upd.voice ? 'voice' : (upd.photo ? 'photo' : (upd.document ? 'document' : (upd.video ? 'video' : (upd.location ? 'location' : (upd.sticker ? 'sticker' : 'unknown'))))));\n  const fn = KIND[kind] ? KIND[kind] : KIND.unknown;\n  textMessage = fn(upd);\n  isAudio = kind === 'voice';\n  voiceFileId = kind === 'voice' ? (upd.voice.file_id ? upd.voice.file_id : null) : null;\n} else {\n  textMessage = '[unsupported update type]';\n}\nreturn [{ json: { messageId: messageId, chatId: chatId, userId: userId, pushName: pushName, provider: 'telegram', isAudio: isAudio, voiceFileId: voiceFileId, textMessage: String(textMessage).trim(), timestamp: new Date().toISOString() } }];"
      },
