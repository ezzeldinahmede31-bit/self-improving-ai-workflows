        "jsCode": "// Flag explicit confirmation replies (tight opt-in vocabulary only).\nconst inp = $input.first().json;\nconst t = inp.finalMessage ? String(inp.finalMessage).trim().toLowerCase() : '';\nconst rx = /^(تمام|تم|اوك|ok|yes|موافق|تاكيد|تأكيد|اكيد|أكيد|ماشي|نعم|ايوه|ايوة|1|👍)(\\s|[!\\\\uFF01.،,👍]|$)/;\nconst hit = rx.test(t);\nreturn [{ json: { chatId: inp.chatId ? String(inp.chatId) : 'unknown', pushName: inp.pushName ? String(inp.pushName) : '', provider: inp.provider ? String(inp.provider) : '', finalMessage: inp.finalMessage ? String(inp.finalMessage) : '', wasVoice: !!inp.wasVoice, isAudioMuffled: !!inp.isAudioMuffled, confirmed: hit, at: Date.now() } }];"
