    {
      "parameters": {
        "jsCode": "// Whisper quality check: fall back to a polite retry prompt on empty audio.\nconst item = $input.first().json;\nconst prev = $('Extract Telegram Payload').first().json;\nconst t = item.text ? String(item.text).trim() : '';\nconst bad = item.error ? true : (t.length < 2);\nconst fallback = '[voice note unclear - kindly ask the patient to re-record in a quiet place or type the message]';\nreturn [{ json: { chatId: prev.chatId, pushName: prev.pushName, provider: prev.provider, finalMessage: bad ? fallback : t, wasVoice: true, isAudioMuffled: bad } }];"
      },
      "id": "tg-12-wcheck",
      "name": "Whisper Fallback & Text Merger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
