    {
      "parameters": {
        "jsCode": "// Verify Telegram secret_token header (fail-closed). The webhook\n// headerAuth credential is the primary gate; this node adds a second check\n// against the container env value before any payload handling.\nconst inp = $input.first().json;\nconst body = inp.body;\nconst headers = inp.headers ? inp.headers : {};\nconst secret = $env.TELEGRAM_WEBHOOK_SECRET ? $env.TELEGRAM_WEBHOOK_SECRET : '';\nif (!secret) { throw new Error('TELEGRAM_WEBHOOK_SECRET is not configured - refusing all traffic'); }\nconst got = headers['x-telegram-bot-api-secret-token'] ? String(headers['x-telegram-bot-api-secret-token']).trim() : '';\nif (!got) { throw new Error('Missing Telegram secret header - rejected'); }\nfunction safeEqual(a, b) {\n  const x = String(a);\n  const y = String(b);\n  if (x.length !== y.length) { return false; }\n  let d = 0;\n  for (let i = 0; i < x.length; i++) { d |= x.charCodeAt(i) ^ y.charCodeAt(i); }\n  return d === 0;\n}\nif (!safeEqual(got, secret)) { throw new Error('Invalid Telegram secret header - rejected'); }\nreturn [{ json: { provider: 'telegram', verified: true, body: body, headers: headers } }];"
      },
      "id": "tg-2-verify",
      "name": "Verify Telegram Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
