        "jsCode": "// Format queue stats for staff (tolerant reads).\nfunction readVal(v) {\n  const t = (typeof v === 'string') ? v : JSON.stringify(v);\n  try { const p = JSON.parse(t); return (p && typeof p === 'object' && !p.value) ? p : (p.value !== undefined ? p.value : p); }\n  catch (e) { return null; }\n}\nconst srv = readVal($('Read Serving Stat').first().json);\nconst tot = readVal($('Read Queue Counter').first().json);\nconst sNum = (srv === null || isNaN(Number(srv))) ? null : Number(srv);\nconst total = (tot === null || isNaN(Number(tot))) ? 0 : Number(tot);\nconst head = sNum === null ? 'الدور الحالي غير معلن بعد.' : ('الدور الحالي ' + String(sNum) + '.');\nreturn [{ json: { message: '📊 الطابور اليوم: ' + head + ' إجمالي الأرقام ' + String(total) + '.' } }];"
