{"name": "sched-today-api", "nodes": [{"id": "sdt-1", "name": "Receive Dashboard Request", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "position": [120, 300], "parameters": {"httpMethod": "GET", "path": "sched-today", "responseMode": "lastNode", "authentication": "headerAuth", "pinnedData": [{"json": {"ping": "pinned-sample"}}]}, "credentials": {"httpHeaderAuth": {"id": "GmhAhc6EXazi8Ptc", "name": "Staff Dashboard Header Auth"}}}, {"id": "sdt-2", "name": "Build Day Window", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [320, 300], "parameters": {"jsCode": "const f=new Intl.DateTimeFormat('en-CA',{timeZone:'Africa/Cairo',year:'numeric',month:'2-digit',day:'2-digit'}); const p=f.formatToParts(new Date()).reduce((a,x)=>(a[x.type]=x.value,a),{}); const d=p.year+'-'+p.month+'-'+p.day; return [{json:{day:d,timeMin:d+'T00:00:00+03:00',timeMax:d+'T23:59:59+03:00'}}];", "pinnedData": [{"json": {"ping": "pinned-sample"}}]}}, {"id": "sdt-3", "name": "List Today Events", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [520, 300], "parameters": {"method": "GET", "url": "={{ 'https://www.googleapis.com/calendar/v3/calendars/primary/events?singleEvents=true&orderBy=startTime&timeMin=' + $('Build Day Window').first().json.timeMin + '&timeMax=' + $('Build Day Window').first().json.timeMax }}", "authentication": "predefinedCredentialType", "nodeCredentialType": "googleCalendarOAuth2Api", "options": {"timeout": 30000}}, "credentials": {"googleCalendarOAuth2Api": {"id": "iFjuW0ce6IHFydGn", "name": "Google Calendar account"}}, "retryOnFail": true, "onError": "continueRegularOutput"}, {"id": "sdt-4", "name": "Read Serving Number", "type": "n8n-nodes-base.redis", "typeVersion": 1, "position": [720, 300], "parameters": {"operation": "get", "key": "={{ 'serving:' + $now.toISO().slice(0, 10) }}"}, "credentials": {"redis": {"id": "dVToMpaQ33TGQdX3", "name": "Redis account"}}, "retryOnFail": true, "onError": "continueRegularOutput"}, {"id": "sdt-5", "name": "Read Queue Counter", "type": "n8n-nodes-base.redis", "typeVersion": 1, "position": [920, 300], "parameters": {"operation": "get", "key": "={{ 'queue:' + $now.toISO().slice(0, 10) }}"}, "credentials": {"redis": {"id": "dVToMpaQ33TGQdX3", "name": "Redis account"}}, "retryOnFail": true, "onError": "continueRegularOutput"}, {"id": "sdt-6", "name": "Format Schedule Payload", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1120, 300], "parameters": {"jsCode": "const ev=(($('List Today Events').first().json.items)||[]); const fmt=new Intl.DateTimeFormat('en-GB',{timeZone:'Africa/Cairo',hour:'2-digit',minute:'2-digit',hour12:false}); const rows=ev.filter(e=>e.status!=='cancelled').map(e=>{const s=e.start&&(e.start.dateTime||e.start.date)||''; let t=s; try{t=fmt.format(new Date(s));}catch(x){} return {id:e.id||'',time:t,summary:e.summary||'',description:e.description||''};}); const sv=$('Read Serving Number').first().json; const q=$('Read Queue Counter').first().json; const sk=Object.keys(sv)[0]; const qk=Object.keys(q)[0]; return [{json:{day:$('Build Day Window').first().json.day,serving:sk?Number(sv[sk]):0,queue:qk?Number(q[qk]):0,total:rows.length,appointments:rows}}];", "pinnedData": [{"json": {"ping": "pinned-sample"}}]}}], "connections": {"Receive Dashboard Request": {"main": [[{"node": "Build Day Window", "type": "main", "index": 0}]]}, "Build Day Window": {"main": [[{"node": "List Today Events", "type": "main", "index": 0}]]}, "List Today Events": {"main": [[{"node": "Read Serving Number", "type": "main", "index": 0}]]}, "Read Serving Number": {"main": [[{"node": "Read Queue Counter", "type": "main", "index": 0}]]}, "Read Queue Counter": {"main": [[{"node": "Format Schedule Payload", "type": "main", "index": 0}]]}}}