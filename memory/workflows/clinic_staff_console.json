    {
      "parameters": {
        "jsCode": "// Extract staff text message (text commands only).\nconst inp = $input.first().json;\nconst body = inp.body;\nconst m = body.message ? body.message : null;\nconst from = m && m.from ? m.from : {};\nconst chat = m && m.chat ? m.chat : {};\nreturn [{ json: { chatId: m ? String(chat.id || '') : '', userId: String(from.id || ''),\n  pushName: from.first_name ? String(from.first_name) : 'staff',\n  textMessage: m && m.text ? String(m.text).trim() : '' } }];"
      },
      "id": "st-3",
      "name": "Extract Staff Message",
