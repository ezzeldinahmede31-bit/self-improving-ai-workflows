    {
      "parameters": {
        "jsCode": "// Format queue stats for staff (tolerant reads).\nfunction readVal(v) {\n  const t = (typeof v === 'string') ? v : JSON.stringify(v);\n  try {\n    const p = JSON.parse(t);\n    const u = (p && typeof p === 'object' && p.propertyName !== undefined) ? p.propertyName : p;\n    return (u && typeof u === 'object' && !u.value) ? u : ((u && typeof u === 'object' && u.value !== undefined) ? u.value : u);\n  }\n  catch (e) { return null; }\n}\nconst srv = readVal($('Read Serving Stat').first().json);\nconst tot = readVal($('Read Queue Counter').first().json);\nconst sNum = (srv === null || isNaN(Number(srv))) ? null : Number(srv);\nconst total = (tot === null || isNaN(Number(tot))) ? 0 : Number(tot);\nconst head = sNum === null ? 'الدور الحالي غير معلن بعد.' : ('الدور الحالي ' + String(sNum) + '.');\nreturn [{ json: { message: '📊 الطابور اليوم: ' + head + ' إجمالي الأرقام ' + String(total) + '.' } }];"
      },
