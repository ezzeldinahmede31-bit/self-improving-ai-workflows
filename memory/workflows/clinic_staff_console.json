    {
      "parameters": {
        "jsCode": "// Format today agenda from reminder key names (no patient names listed).\nconst j = $input.first().json;\nconst src = Array.isArray(j) ? j : Object.keys(j || {});\nconst today = new Date().toISOString().slice(0, 10);\nconst rows = src\n  .filter((k) => String(k).indexOf('remind:') === 0)\n  .map((k) => String(k).split(':'))\n  .filter((p) => p.length >= 5 && p[3] === today)\n  .map((p) => ({ time: p[4], doctor: p[2] }));\nrows.sort((a, b) => (a.time < b.time ? -1 : 1));\nconst lines = rows.map((r) => '• ' + r.time + ' — ' + r.doctor);\nconst head = '📋 حجوزات اليوم (' + String(rows.length) + '):';\nconst msg = rows.length === 0 ? 'لا توجد حجوزات اليوم.' : (head + '\\n' + lines.join('\\n'));\nreturn [{ json: { message: msg } }];"
      },
