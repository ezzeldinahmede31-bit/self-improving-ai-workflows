      "parameters": {
        "jsCode": "// Verify staff webhook secret (fail-closed, constant-time compare).\nconst inp = $input.first().json;\nconst body = inp.body;\nconst headers = inp.headers ? inp.headers : {};\nconst secret = $env.TELEGRAM_SECRETARY_WEBHOOK_SECRET ? $env.TELEGRAM_SECRETARY_WEBHOOK_SECRET : '';\nif (!secret) { throw new Error('TELEGRAM_SECRETARY_WEBHOOK_SECRET is not configured - refusing all traffic'); }\nconst got = headers['x-telegram-bot-api-secret-token'] ? String(headers['x-telegram-bot-api-secret-token']).trim() : '';\nif (!got) { throw new Error('Missing secret header - rejected'); }\nfunction safeEqual(a, b) {\n  const x = String(a);\n  const y = String(b);\n  if (x.length !== y.length) { return false; }\n  let d = 0;\n  for (let i = 0; i < x.length; i++) { d |= x.charCodeAt(i) ^ y.charCodeAt(i); }\n  return d === 0;\n}\nif (!safeEqual(got, secret)) { throw new Error('Invalid secret header - rejected'); }\nreturn [{ json: { provider: 'staff', verified: true, body: body } }];"
      },
      "id": "st-2",
      "name": "Verify Staff Secret",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
