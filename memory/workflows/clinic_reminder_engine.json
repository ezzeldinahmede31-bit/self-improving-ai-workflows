    {
      "parameters": {
        "jsCode": "// Pop the oldest waiter for each freed offer (duplicate-offer race accepted: booking lock keeps taps safe).\nconst outs = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  const offerKey = Object.keys(j).find((k) => String(k).indexOf('offer:') === 0);\n  if (!offerKey) { continue; }\n  let offer = null;\n  try { offer = JSON.parse(j[offerKey]); } catch (e) { offer = null; }\n  if (!offer) { continue; }\n  outs.push({ json: { offerKey: offerKey, offer: offer, waiter: null, rest: '[]' } });\n}\nreturn outs;"
      },
