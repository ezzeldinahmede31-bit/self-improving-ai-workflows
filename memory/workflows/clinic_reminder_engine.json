    {
      "parameters": {
        "jsCode": "// Fan the KEYS map out to decided items (confirmation lives in-record).\n// Two-touch cadence (world standard): info at T-24h (infoSentAt), confirm at T-2h (remindedAt, button).\nconst j = $input.first().json;\nconst now = Date.now();\nconst parseRec = (v) => {\n  if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return null; } }\n  return (v && typeof v === 'object') ? v : null;\n};\nconst shape = (rec) => {\n  const appt = Date.parse(rec.appointmentISO);\n  const infoAt = Number(rec.infoSentAt) || null;\n  const rAt = Number(rec.remindedAt) || null;\n  const confAt = Number(rec.confirmedAt) || null;\n  const fresh = confAt !== null && rAt !== null && confAt > rAt;\n  const future = !isNaN(appt) && appt > now;\n  const endedAgo = !isNaN(appt) ? now - appt : -1;\n  return { json: { record: rec,\n    needsInfo: !isNaN(appt) && !infoAt && future && now >= appt - 24 * 3600 * 1000,\n    needsRemind: !isNaN(appt) && !rAt && future && now >= appt - 2 * 3600 * 1000,\n    needsPostVisit: !isNaN(appt) && !rec.followedUp && !!confAt && endedAgo > 45 * 60 * 1000 && endedAgo < 20 * 3600 * 1000,\n    needsCleanup: isNaN(appt) || appt < now - 2 * 3600 * 1000,\n    needsEscalation: !isNaN(appt) && !!rAt && !fresh && future && now > rAt + 120000 } };\n};\nreturn Object.keys(j || {})\n  .filter((k) => String(k).indexOf('remind:') === 0)\n  .map((k) => parseRec(j[k]))\n  .filter((rec) => rec && rec.appointmentISO)\n  .map((rec) => shape(rec));"
      },
      "id": "en-sk",
      "name": "Split Map To Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
