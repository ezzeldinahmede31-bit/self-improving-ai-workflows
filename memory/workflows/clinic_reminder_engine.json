      "name": "List Reminder Keys",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        320,
        300
      ],
      "credentials": {
        "redis": {
          "id": "dVToMpaQ33TGQdX3",
          "name": "Redis account"
        }
      },
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Fan the KEYS map out to decided items (confirmation lives in-record).\nconst j = $input.first().json;\nconst now = Date.now();\nconst parseRec = (v) => {\n  if (typeof v === 'string') { try { return JSON.parse(v); } catch (e) { return null; } }\n  return (v && typeof v === 'object') ? v : null;\n};\nconst shape = (rec) => {\n  const appt = Date.parse(rec.appointmentISO);\n  const lead = (Number(rec.leadHours) || 6) * 3600 * 1000;\n  const rAt = Number(rec.remindedAt) || null;\n  const confAt = Number(rec.confirmedAt) || null;\n  const fresh = confAt !== null && rAt !== null && confAt > rAt;\n  const future = !isNaN(appt) && appt > now;\n  return { json: { record: rec,\n    needsRemind: !isNaN(appt) && !rAt && future && now >= appt - lead,\n    needsCleanup: isNaN(appt) || appt < now - 2 * 3600 * 1000,\n    needsEscalation: !isNaN(appt) && !!rAt && !fresh && future && now > rAt + 120000 } };\n};\nreturn Object.keys(j || {})\n  .filter((k) => String(k).indexOf('remind:') === 0)\n  .map((k) => parseRec(j[k]))\n  .filter((rec) => rec && rec.appointmentISO)\n  .map((rec) => shape(rec));"
      },
      "id": "en-sk",
      "name": "Split Map To Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
