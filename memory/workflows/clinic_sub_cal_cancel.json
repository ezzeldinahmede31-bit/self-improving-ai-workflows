      "id": "cal-125",
      "name": "Fetch Event Details",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.2,
      "position": [
        480,
        420
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "R8AjuV0uT9m8lgQe",
          "name": "Google Calendar account"
        }
      },
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// 24h cutoff (world dental standard): inside 24h -> staff only.\nconst inp = $input.first().json;\nconst trigIn = $('Receive Booking Request').first().json;\nconst ev = (inp && !inp.error) ? inp : null;\nconst startMs = ev ? Date.parse(ev.start && (ev.start.dateTime || ev.start.date)) : NaN;\nconst eid = trigIn.eventId ? String(trigIn.eventId) : '';\nif (!eid) { return [{ json: { ok: false, staffOnly: false, message: 'لا أجد رقم الحجز. تواصل مع الاستقبال للإلغاء من فضلك.', eventId: '' } }]; }\nif (ev && ev.error !== undefined) { return [{ json: { ok: false, staffOnly: true, message: 'تعذر الوصول للحجز. تم إخطار الطاقم.', eventId: eid } }]; }\nif (isNaN(startMs)) { return [{ json: { ok: false, staffOnly: true, message: 'تعذر قراءة الحجز. تم إخطار الطاقم.', eventId: eid } }]; }\nconst hrsLeft = (startMs - Date.now()) / 3600000;\nif (hrsLeft < 24) { return [{ json: { ok: false, staffOnly: true, cutoff: true, message: 'هذا الميعاد خلال أقل من 24 ساعة — الإلغاء عبر الطاقم فقط. تم إخطارهم.', eventId: eid, startISO: new Date(startMs).toISOString() } }]; }\nconst cairo = new Intl.DateTimeFormat('en-CA', { timeZone: 'Africa/Cairo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(startMs));\nconst ctime = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Cairo', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(startMs));\nreturn [{ json: { ok: true, eventId: eid, startISO: new Date(startMs).toISOString(),\n  date: cairo, time: ctime,\n  doctor: trigIn.doctorName ? String(trigIn.doctorName) : 'any-doctor',\n  service: trigIn.serviceName ? String(trigIn.serviceName) : 'general visit',\n  patientName: trigIn.patientName ? String(trigIn.patientName) : 'patient',\n  patientChat: trigIn.patientChatId ? String(trigIn.patientChatId) : '' } }];"
      },
      "id": "cal-126",
      "name": "Check Cancel Cutoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        420
      ]
    },
