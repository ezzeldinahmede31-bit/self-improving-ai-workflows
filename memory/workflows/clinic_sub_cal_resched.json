        "jsCode": "// Reschedule contract (Cairo wall time).\nconst nw = $('Decide New Free').first().json;\nconst eid = $('Create New Event').first().json.id || '';\nconst cairo = new Intl.DateTimeFormat('en-CA', { timeZone: 'Africa/Cairo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(nw.newStartISO));\nconst ctime = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Cairo', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(nw.newStartISO));\nreturn [{ json: { moved: true, newEventId: String(eid), message: 'تم نقل حجزك إلى ' + cairo + ' الساعة ' + ctime + ' (' + nw.service + ' مع ' + nw.doctor + ').' } }];"
