    {
      "parameters": {
        "jsCode": "// Reschedule = atomic swap. Old inside 24h -> staff only (same dental standard as cancel).\nconst inp = $input.first().json;\nconst trig = $('Receive Booking Request').first().json;\nconst eid = trig.eventId ? String(trig.eventId) : '';\nconst ev = (inp && inp.error === undefined) ? inp : null;\nconst startMs = ev ? Date.parse(ev.start && (ev.start.dateTime || ev.start.date)) : NaN;\nif (!eid) { return [{ json: { ok: false, message: 'لا أجد رقم الحجز القديم. تواصل مع الاستقبال من فضلك.' } }]; }\nif (!ev || isNaN(startMs)) { return [{ json: { ok: false, staffOnly: true, message: 'تعذر قراءة الحجز القديم. تم إخطار الطاقم.', eventId: eid } }]; }\nif ((startMs - Date.now()) < 24 * 3600 * 1000) { return [{ json: { ok: false, staffOnly: true, cutoff: true, message: 'هذا الميعاد خلال أقل من 24 ساعة — التأجيل عبر الطاقم فقط. تم إخطارهم.', eventId: eid } }]; }\nreturn [{ json: { ok: true, oldEventId: eid,\n  doctor: trig.doctorName ? String(trig.doctorName) : 'any-doctor',\n  service: trig.serviceName ? String(trig.serviceName).trim() : 'general visit',\n  patientName: trig.patientName ? String(trig.patientName) : 'patient',\n  patientChat: trig.patientChatId ? String(trig.patientChatId) : '',\n  newDate: trig.newDate ? String(trig.newDate).trim() : '',\n  newTime: trig.newTime ? String(trig.newTime).trim() : '' } }];"
      },
