      "parameters": {
        "jsCode": "// New-slot window with Cairo wall time + per-service duration (mirror of book lane).\nconst MINUTES = Object.assign({}, {'General exam': 30, 'Cleaning and polishing': 45, 'Filling per tooth': 45, 'Root canal': 90, 'Braces consult': 30, 'Implant consult': 30, 'Whitening': 60}, (function(){ try { return $('Build Durations Map').first().json.minutesMap || {}; } catch (e) { return {}; } })());\nconst c = $('Check Resched Cutoff').first().json;\nconst mins = MINUTES[c.service] || 30;\nconst cairoISO = (d, t) => {\n  const try2 = d + 'T' + t + ':00+02:00';\n  const wall = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Cairo', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(try2));\n  const hm = wall.split(':'); const wt = t.split(':');\n  return (Number(hm[0]) === Number(wt[0]) && Number(hm[1]) === Number(wt[1])) ? try2 : (d + 'T' + t + ':00+03:00');\n};\nconst start = new Date(cairoISO(c.newDate, c.newTime));\nconst end = new Date(start.getTime() + mins * 60 * 1000);\nconst bad = isNaN(start.getTime()) || start.getTime() < Date.now() + 15 * 60 * 1000;\nreturn [{ json: { newSlotKey: 'slot:' + c.doctor + ':' + c.newDate + ':' + c.newTime,\n  newStartISO: isNaN(start.getTime()) ? '' : start.toISOString(),\n  newEndISO: isNaN(start.getTime()) ? '' : end.toISOString(),\n  bad: bad, oldEventId: c.oldEventId, doctor: c.doctor, service: c.service,\n  patientName: c.patientName, patientChat: c.patientChat,\n  newDate: c.newDate, newTime: c.newTime, minutes: mins } }];"
      },
