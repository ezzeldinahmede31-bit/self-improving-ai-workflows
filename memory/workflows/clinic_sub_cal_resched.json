      "parameters": {
        "jsCode": "// Re-key the reminder record onto the new slot (confirmation cycle restarts).\nlet old = null;\ntry { old = JSON.parse($input.first().json.propertyName || 'null'); } catch (e) { old = null; }\nconst nw = $('Decide New Free').first().json;\nif (!old) { old = { chatId: nw.patientChat, patientName: nw.patientName, doctor: nw.doctor, service: nw.service, queueNumber: 0 }; }\nold.appointmentISO = nw.newStartISO; old.date = nw.newDate; old.time = nw.newTime;\nold.slotKey = nw.newSlotKey; old.infoSentAt = 0; old.remindedAt = 0; old.confirmedAt = 0;\nold.escalatedAt = 0; old.followedUp = 0;\nreturn [{ json: { updated: JSON.stringify(old),\n  newKey: 'remind:' + nw.patientChat + ':' + nw.newSlotKey,\n  oldEventId: nw.oldEventId, newEventId: '' } }];"
