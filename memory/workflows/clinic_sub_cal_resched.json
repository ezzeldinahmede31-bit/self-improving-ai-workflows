        "jsCode": "// Availability verdict for the NEW slot (always exactly one item).\nconst inp = $input.first().json;\nconst prev = $('Build New Slot Window').first().json;\nconst failed = inp.error !== undefined;\nconst items = failed ? [] : (Array.isArray(inp.items) ? inp.items : []);\nreturn [{ json: { free: !failed && items.length === 0, checkFailed: failed,\n  newSlotKey: prev.newSlotKey, newStartISO: prev.newStartISO, newEndISO: prev.newEndISO,\n  oldEventId: prev.oldEventId, doctor: prev.doctor, service: prev.service,\n  patientName: prev.patientName, patientChat: prev.patientChat,\n  newDate: prev.newDate, newTime: prev.newTime } }];"
