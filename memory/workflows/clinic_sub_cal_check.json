      "id": "cal-chk-trig",
      "name": "Receive Booking Request",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Read-only slot probe (never locks, never books): Cairo window + 30-min default.\nconst inp = $input.first().json;\nconst date = inp.date ? String(inp.date).trim() : '';\nconst time = inp.time ? String(inp.time).trim() : '';\nconst cairoISO = (d, t) => {\n  const try2 = d + 'T' + t + ':00+02:00';\n  const wall = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Cairo', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(try2));\n  const hm = wall.split(':'); const wt = t.split(':');\n  return (Number(hm[0]) === Number(wt[0]) && Number(hm[1]) === Number(wt[1])) ? try2 : (d + 'T' + t + ':00+03:00');\n};\nconst start = new Date(cairoISO(date, time));\nconst end = new Date(start.getTime() + 30 * 60 * 1000);\nreturn [{ json: { startISO: isNaN(start.getTime()) ? '' : start.toISOString(),\n  endISO: isNaN(start.getTime()) ? '' : end.toISOString(),\n  bad: isNaN(start.getTime()), date: date, time: time } }];"
      },
      "id": "cal-chk-win",
      "name": "Build Check Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://www.googleapis.com/calendar/v3/calendars/primary/events?singleEvents=true&orderBy=startTime&timeMin=' + $input.item.json.startISO + '&timeMax=' + $input.item.json.endISO }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {
          "timeout": 30000
        }
      },
      "id": "cal-chk-list",
      "name": "List Check Window",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "R8AjuV0uT9m8lgQe",
          "name": "Google Calendar account"
        }
      },
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Availability verdict only.\nconst inp = $input.first().json;\nconst prev = $('Build Check Window').first().json;\nif (prev.bad) { return [{ json: { free: false, bad: true, message: 'تاريخ غير صالح.' } }]; }\nconst failed = inp.error !== undefined;\nconst items = failed ? [] : (Array.isArray(inp.items) ? inp.items : []);\nreturn [{ json: { free: !failed && items.length === 0, checkFailed: failed,\n  date: prev.date, time: prev.time,\n  message: failed ? 'تعذر فحص الإتاحة.' : (items.length === 0 ? ('ميعاد ' + prev.date + ' الساعة ' + prev.time + ' متاح.') : ('ميعاد ' + prev.date + ' الساعة ' + prev.time + ' محجوز.')) } }];"
      },
      "id": "cal-chk-reply",
      "name": "Reply Availability",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    }
