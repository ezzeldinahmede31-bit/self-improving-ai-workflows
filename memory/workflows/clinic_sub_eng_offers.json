      "id": "en-off-0",
      "name": "Receive Lane Item",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Pop the oldest waiter for each freed offer (duplicate-offer race accepted: booking lock keeps taps safe).\nconst outs = [];\nfor (const it of [{ json: ($input.first().json.keysmap || {}) }]) {\n  const j = it.json;\n  const offerKey = Object.keys(j).find((k) => String(k).indexOf('offer:') === 0);\n  if (!offerKey) { continue; }\n  let offer = null;\n  try { offer = JSON.parse(j[offerKey]); } catch (e) { offer = null; }\n  if (!offer) { continue; }\n  outs.push({ json: { offerKey: offerKey, offer: offer, waiter: null, rest: '[]' } });\n}\nreturn outs;"
      },
      "id": "eng-346",
      "name": "Take Oldest Waiter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        1400
      ]
    },
    {
      "parameters": {
        "operation": "pop",
        "list": "waitlist"
      },
      "id": "eng-410-pop",
      "name": "Pop Waitlist",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        640,
        1400
      ],
      "credentials": {
        "redis": {
          "id": "dVToMpaQ33TGQdX3",
          "name": "Redis account"
        }
      },
      "retryOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Merge popped waiter with the shaped offer (empty pop -> stop).\nconst win = $input.first().json;\nconst w = (win && win.propertyName !== undefined && win.propertyName !== null) ? win.propertyName : win;\nconst shaped = $('Take Oldest Waiter').item.json;\nconst waiter = (typeof w === 'string') ? (function(){ try { return JSON.parse(w); } catch (e) { return null; } })() : (w && (w.value || w.data) ? (function(){ try { return JSON.parse(w.value || w.data); } catch (e) { return null; } })() : w);\nif (!waiter || !waiter.chatId) { return []; }\nreturn [{ json: { offerKey: shaped.offerKey, offer: shaped.offer, waiter: waiter } }];"
      },
      "id": "eng-411-merge",
      "name": "Merge Offer Waiter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        1400
      ]
    },
