[{"title": "The Prince", "authors": ["Niccolò Machiavelli"], "year": 1515, "editions": 1407, "openlibrary_key": "/works/OL1089297W", "desc": "The Prince (Italian: Il Principe [il ˈprintʃipe]; Latin: De Principatibus) is a 16th-century political treatise written by Italian diplomat and political theorist Niccolò Machiavelli as an instruction guide for new princes and royals. The general theme of The Prince is of accepting that the aims of princes – such as glory and survival – can justify the use of immoral means to achieve those ends.\r\n"}, {"title": "Prince", "authors": ["Niccolò Machiavelli"], "year": 1998, "editions": 183, "openlibrary_key": "/works/OL21456413W", "desc": "\"The Prince\" is the most controversial book about winning power - and holding on to it - ever written. Machiavelli's tough-minded, pragmatic argument that sometimes it is necessary to abandon ethics to succeed made his name notorious. Yet his book has been read by strategists, politicians and business people ever since as the ultimate guide to realpolitik. How can a leader be strong and decisive, "}, {"title": "Dell'Arte della Guerra", "authors": ["Niccolò Machiavelli"], "year": 1540, "editions": 140, "openlibrary_key": "/works/OL15968W", "desc": ""}, {"title": "Istorie Fiorentine", "authors": ["Niccolò Machiavelli", "Félix Fernández Murga", "Félix Gilbert", "Peter Whithorne", "Giovanni Battista Niccolini"], "year": 1577, "editions": 112, "openlibrary_key": "/works/OL15942W", "desc": "The extraordinary times, persons and events in Florence, Italy history from the period of 379-1492."}, {"title": "Discourses on Livy", "authors": ["Niccolò Machiavelli", "Harvey C. Mansfield", "Nathan Tarcov", "Alissa Ardito", "Ninian Hill Thomson", "Henry Neville"], "year": 1531, "editions": 81, "openlibrary_key": "/works/OL1089260W", "desc": "<p>A very different work from his well-known <i><a href=\"https://standardebooks.org/ebooks/niccolo-machiavelli/the-prince/w-k-marriott\">The Prince</a></i>, and posthumously published a year prior to it, <a href=\"https://standardebooks.org/ebooks/niccolo-machiavelli\">Machiavelli’s</a> <i>Discourses on Livy</i> is one of his most debated works. Some critics see it as presenting a counterpoint or ref"}, {"title": "PrÍncipe", "authors": ["Niccolò Machiavelli", "Jhonathan Valle", "Libros Valle"], "year": 2020, "editions": 56, "openlibrary_key": "/works/OL35787395W", "desc": ""}, {"title": "Mandragola", "authors": ["Niccolò Machiavelli"], "year": 1554, "editions": 53, "openlibrary_key": "/works/OL15991W", "desc": ""}, {"title": "Art of War", "authors": ["Niccolò Machiavelli"], "year": 2016, "editions": 52, "openlibrary_key": "/works/OL28915698W", "desc": ""}, {"title": "Principe", "authors": ["Niccolò Machiavelli"], "year": 2010, "editions": 48, "openlibrary_key": "/works/OL28992290W", "desc": ""}, {"title": "Opere", "authors": ["Niccolò Machiavelli"], "year": 1796, "editions": 45, "openlibrary_key": "/works/OL15988W", "desc": ""}, {"title": "Tutte le opere di Nicolo Machiauelli, cittadino et secretario fiorentino", "authors": ["Niccolò Machiavelli"], "year": 1549, "editions": 34, "openlibrary_key": "/works/OL15960W", "desc": ""}, {"title": "Discorsi sopra la prima deca di Tito Livio", "authors": ["Niccolò Machiavelli"], "year": 1824, "editions": 28, "openlibrary_key": "/works/OL15980W", "desc": ""}, {"title": "Art of War", "authors": ["Niccolò Machiavelli"], "year": 2015, "editions": 26, "openlibrary_key": "/works/OL41448451W", "desc": ""}, {"title": "Art of War", "authors": ["Niccolò Machiavelli"], "year": 2015, "editions": 25, "openlibrary_key": "/works/OL40431845W", "desc": ""}, {"title": "Prince", "authors": ["Niccolò Machiavelli", "Benjamin van Blancke", "Jean Jacques Marchand", "Paul Larivaille"], "year": 2011, "editions": 25, "openlibrary_key": "/works/OL21865241W", "desc": ""}, {"title": "La mandragola", "authors": ["Niccolò Machiavelli", "Osimo Vittorio"], "year": 1914, "editions": 23, "openlibrary_key": "/works/OL15243974W"