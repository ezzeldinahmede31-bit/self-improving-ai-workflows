    {
      "parameters": {
        "jsCode": "// Compute queue reply (tolerant reads, Arabic-first chic copy).\nfunction readVal(v) {\n  const un = (x) => {\n    if (x && typeof x === 'object' && x.propertyName !== undefined) { return un(x.propertyName); }\n    if (typeof x === 'string') { const t = x.trim(); if (t.startsWith('{') || t.startsWith('[')) { try { return JSON.parse(t); } catch (e) { return t; } } return t; }\n    if (x && typeof x === 'object' && x.value !== undefined) { return x.value; }\n    return x;\n  };\n  return un(v);\n}\nconst rec = readVal($('Read Booking Record').first().json);\nconst srv = readVal($input.first().json);\nconst sNum = srv === null ? null : Number(srv);\nif (rec === null || !rec.queueNumber) {\n  return [{ json: { found: false, message: 'لا يوجد حجز قادم باسمك. احجز أولا وسأخبرك برقم دورك.' } }];\n}\nconst mine = Number(rec.queueNumber);\nconst left = (sNum === null || isNaN(sNum)) ? null : Math.max(0, mine - sNum);\nconst head = 'رقم دورك ' + String(mine) + '️⃣';\nconst body = left === null ? 'لم يعلن الدور الحالي بعد.' : (left === 0 ? 'دورك الحالي الآن! توجه للاستقبال.' : ('الدور الحالي ' + String(sNum) + '، فاضل ' + String(left) + ' قبلك ✅'));\nreturn [{ json: { found: true, message: head + '\\n' + body } }];"
      },
      "id": "sq-c",
      "name": "Compute Queue Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        300
      ]
    }
